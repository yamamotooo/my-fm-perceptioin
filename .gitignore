# ===== 依存関係 =====
node_modules/

# ===== ビルド成果物 =====
dist/
out/

# ===== パッケージファイル =====
*.vsix

# ===== テスト =====
.vscode-test/

# ===== ソースマップ =====
**/*.js.map

# ===== ログ =====
*.log
npm-debug.log*

# ===== OS =====
.DS_Store
Thumbs.db

# ===== エディタ設定（ローカル） =====
.env
.env.local
.env.*.local

# ===== 【機密】データフォルダ =====
# FileMakerの入力XML・書き出し先をすべて data/ にまとめる
# data/.gitkeep のみ追跡し、中身は一切コミットしない
data/*
!data/.gitkeep
*.fmp12

# ===== 認証情報・シークレット =====
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*
